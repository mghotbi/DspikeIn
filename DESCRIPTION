Type: Package
Package: DspikeIn
Title: Estimating Absolute Abundance from Microbial Spike-in Controls
Version: 0.99.14
Authors@R: c(
    person("Mitra", "Ghotbi", , "mitra.ghotbi@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9185-9993")),
