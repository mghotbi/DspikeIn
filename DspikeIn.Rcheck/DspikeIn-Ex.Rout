+   facet_variable = "Diet",
+   top_n_taxa = 10,
+   x_scale = "fixed",
+   xlab = NULL,
+   legend_columns = 1,
+   x_angle = 25,
+   palette = DspikeIn::color_palette$cool_MG,
+   legend_size = 12
+ )
