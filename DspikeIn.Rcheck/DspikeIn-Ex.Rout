> 
> ### ** Examples
> 
> if (requireNamespace("DspikeIn", quietly = TRUE)) {
+   data("metadata_full", package = "DspikeIn")
+ 
+   plot_object <- regression_plot(
+     data = metadata_full,
+     x_var = "Observed",
+     y_var = "Total_Reads_spiked",
+     custom_range = c(0.1, 15, 30, 50, 75, 100)
+   )
+ 
+   # Print the plot output
+   print(plot_object)
+ }
